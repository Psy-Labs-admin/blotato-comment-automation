# API startup requires a PostgreSQL database and access settings.
# No accounts, automations or conversations are inserted on startup.
ROLE=api
HOST=127.0.0.1
PORT=3000
DATABASE_URL=
TENANT_TOKEN_HASHES=
METRICS_TOKEN_HASH=
WEBHOOK_SIGNING_SECRET=
# Separate key for signed account lifecycle notifications from the integration.
WEBHOOK_PROVISIONING_SECRET=
# Hosted Instagram connection/settings page shown when no account is connected.
INSTAGRAM_CONNECT_URL=
# Set for an API deployment backed by configured workers and relay processes.
DISPATCH_ENABLED=0

# Required by worker, relay and all roles. API-only startup does not use Temporal.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=comment-automations

# Optional existing normalized Instagram integration. Choose it or the native Instagram Login settings below.
INSTAGRAM_BASE_URL=
INSTAGRAM_API_TOKEN=

# Optional independent delivery integrations. Their events stay pending until configured.
CRM_BASE_URL=
CRM_API_TOKEN=
ALERT_SINK_BASE_URL=
ALERT_SINK_API_TOKEN=

# Telegram can provide alert delivery instead of the authenticated webhook above.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public HTTPS origin for links in operational alerts.
CONSOLE_ORIGIN=

# Explicit opt-in retention policy for eligible historical inbox bodies.
INBOX_RETENTION_ENABLED=0
INBOX_RETENTION_DAYS=30

# Native Instagram API with Instagram Login. Keep gateway INSTAGRAM_BASE_URL/API_TOKEN empty in this mode.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_GRAPH_VERSION=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_CAPABILITIES_JSON=
