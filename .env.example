# Postgres started by compose.yaml (host port 55432 avoids clashing with a local Postgres on 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:55432/blotato
# Used by the test harness to create one throw-away database per test file
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:55432/postgres

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=comment-automations

# all | api | worker | relay
ROLE=all
PORT=3000
# FAKES=1 starts fake Instagram/CRM/alert-sink HTTP servers in-process (npm run dev sets it)
FAKES=0
INSTAGRAM_BASE_URL=http://localhost:4001
CRM_BASE_URL=http://localhost:4002
ALERT_SINK_URL=http://localhost:4003

# Optional: real Telegram delivery for grouped incidents (otherwise alerts go to ALERT_SINK_URL)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
