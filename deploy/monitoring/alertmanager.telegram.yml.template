route:
  receiver: operator-telegram
  group_by: [alertname, job, role, kind]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: operator-telegram
    telegram_configs:
      - bot_token_file: /run/secrets/telegram_token
        chat_id: CHAT_ID
        send_resolved: true
        parse_mode: ''
        message: |-
          {{ .Status | toUpper }} · Blotato
          {{ range .Alerts }}{{ .Labels.alertname }}: {{ .Annotations.summary }}
          {{ end }}
