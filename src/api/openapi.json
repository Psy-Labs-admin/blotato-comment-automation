  "components": {
    "securitySchemes": {
      "IntegrationKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Integration API key",
        "description": "Paste the key itself. Swagger adds the Bearer header. Read keys can see captured email addresses. Write keys can also change rules."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The resource UUID in this workspace.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "How many items to return at most.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "description": "Pass nextCursor from the last page. Items sort by createdAt descending, then id descending for ties. A null nextCursor means you reached the end. An unknown cursor or one from another workspace returns 400.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "400": {
        "description": "Check the request fields, query parameters and cursor. For a publish request, check the rule content too.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Supply a valid integration key. A revoked key also gets this response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "description": "Bearer authentication challenge.",
            "schema": {
              "type": "string",
              "const": "Bearer"
            }
          }
        }
      },
      "403": {
        "description": "Use a write key to change a rule. If you send X-Tenant-Id, it must match the workspace on the key. A mismatch returns TENANT_MISMATCH.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "scope": {
                "value": {
                  "error": "This operation requires a write API key.",
                  "code": "INSUFFICIENT_SCOPE"
                }
              },
              "tenant": {
                "value": {
                  "error": "The tenant header conflicts with the API key.",
                  "code": "TENANT_MISMATCH"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "This workspace has no resource with that ID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Read the error code and fetch the latest record before retrying.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "revision_conflict": {
                "value": {
                  "error": "This automation changed. Reload before publishing.",
                  "code": "revision_conflict"
                }
              },
              "account_required": {
                "value": {
                  "error": "Choose a connected Instagram account before publishing.",
                  "code": "account_required"
                }
              },
              "reconnect_required": {
                "value": {
                  "error": "Connect or reconnect this Instagram account before publishing.",
                  "code": "reconnect_required"
                }
              },
              "paused": {
                "value": {
                  "error": "Resume this account before publishing.",
                  "code": "paused"
                }
              },
              "permissions_required": {
                "value": {
                  "error": "The account integration must confirm messaging permissions and limits.",
                  "code": "permissions_required"
                }
              },
              "delivery_unconfigured": {
                "value": {
                  "error": "Configure message delivery before publishing.",
                  "code": "delivery_unconfigured"
                }
              },
              "integration_mismatch": {
                "value": {
                  "error": "Reconnect this account through the configured Instagram integration.",
                  "code": "integration_mismatch"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "The server hit an unexpected error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
