{
  "openapi": "3.1.0",
  "info": {
    "title": "Blotato Automation API",
    "version": "1.0.0",
    "description": "Manage workspace rules and read conversation results from your backend. Use a named integration key. Writes require write scope. Each operation is limited to the workspace that issued the key."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin versioned public API"
    }
  ],
  "security": [
    {
      "IntegrationKey": []
    }
  ],
  "tags": [
    {
      "name": "Workspace",
      "description": "Authenticated workspace identity."
    },
    {
      "name": "Accounts",
      "description": "Connected Instagram account readiness."
    },
    {
      "name": "Drafts",
      "description": "Revision-controlled editing and publication."
    },
    {
      "name": "Automations",
      "description": "Published automation definitions and activation."
    },
    {
      "name": "Runs",
      "description": "Execution records and factual timelines."
    },
    {
      "name": "Leads",
      "description": "Captured leads and CRM state."
    }
  ],
