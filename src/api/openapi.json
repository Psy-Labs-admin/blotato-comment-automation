{
  "openapi": "3.1.0",
  "info": {
    "title": "Blotato Automation API",
    "version": "1.0.0",
    "description": "Connect your backend with a workspace key. Read keys can list runs and leads. Use a write key to edit, publish or pause a rule. Each key works in one workspace."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin versioned public API"
    }
  ],
  "security": [
    {
      "IntegrationKey": []
    }
  ],
  "tags": [
    {
      "name": "Workspace",
      "description": "Which workspace does this key open?"
    },
    {
      "name": "Accounts",
      "description": "Check which Instagram accounts can publish."
    },
    {
      "name": "Drafts",
      "description": "Save a rule, edit it and publish a revision."
    },
    {
      "name": "Automations",
      "description": "Turn published rules on or off."
    },
    {
      "name": "Runs",
      "description": "See what happened after a comment matched."
    },
    {
      "name": "Leads",
      "description": "Get captured email addresses and check CRM delivery."
    }
  ],
  "paths": {
    "/workspace": {
      "get": {
        "operationId": "getWorkspace",
        "tags": [
          "Workspace"
        ],
        "summary": "Get your workspace",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "Your workspace ID and name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "operationId": "listAccounts",
        "tags": [
          "Accounts"
        ],
        "summary": "List Instagram accounts",
        "description": "Includes disconnected accounts. Check canPublish and issue before choosing an account for a rule.",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "Accounts in this workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        }
      }
    },
    "/drafts": {
      "get": {
        "operationId": "listDrafts",
        "tags": [
          "Drafts"
        ],
        "summary": "List automation drafts",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "One page of drafts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      },
      "post": {
        "operationId": "createDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Create an automation draft",
        "description": "A new draft starts at revision 1 with empty content unless you supply it. If the response goes missing, check the draft list before creating another.",
        "x-required-permission": "write",
        "responses": {
          "201": {
            "description": "The saved draft, including its ID and revision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraft"
              },
              "example": {
                "name": "Comment to email follow-up",
                "content": {
                  "keyword": "guide",
                  "publicReply": "I will send the details in a message.",
                  "emailPrompt": "What email should receive the guide?",
                  "linkText": "Here is the guide.",
                  "linkUrl": "https://example.com/guide",
                  "timeoutHours": 72,
                  "maxClarifications": 1,
                  "clarificationText": "Please reply with an email address."
                }
              }
            }
          }
        }
      }
    },
    "/drafts/{id}": {
      "get": {
        "operationId": "getDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Get an automation draft",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "The saved draft and its current revision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      },
      "patch": {
        "operationId": "updateDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Update an automation draft",
        "description": "Send the current expectedRevision. Each save bumps the revision. Fields you leave out keep their values. Sending content replaces the whole object. Set connectionId to null to clear the account. If the response goes missing or you get a revision_conflict, fetch the draft before trying again.",
        "x-required-permission": "write",
        "responses": {
          "200": {
            "description": "The updated draft and its new revision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraft"
              },
              "example": {
                "expectedRevision": 1,
                "content": {
                  "keyword": "guide",
                  "publicReply": "I will send the details in a message.",
                  "emailPrompt": "What email should receive the guide?",
                  "linkText": "Here is the guide.",
                  "linkUrl": "https://example.com/guide",
                  "timeoutHours": 72,
                  "maxClarifications": 1,
                  "clarificationText": "Please reply with an email address."
                }
              }
            }
          }
        }
      }
    },
    "/drafts/{id}/publish": {
      "post": {
        "operationId": "publishDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Publish a draft revision",
        "description": "Publishing checks the rule and account, freezes a version and turns the rule on. If the response goes missing, fetch the draft. Publishing the same unchanged revision again returns the original version, even if the rule was later disabled. An edit makes the older revision stale.",
        "x-required-permission": "write",
        "responses": {
          "200": {
            "description": "The draft, automation ID and published version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpectedRevision"
              },
              "example": {
                "expectedRevision": 2
              }
            }
          }
        }
      }
    },
    "/automations": {
      "get": {
        "operationId": "listAutomations",
        "tags": [
          "Automations"
        ],
        "summary": "List published automations",
        "description": "Includes disabled rules that have a published version.",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "One page of published rules.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      }
    },
    "/automations/{id}": {
      "get": {
        "operationId": "getAutomation",
        "tags": [
          "Automations"
        ],
        "summary": "Get a published automation",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "The rule and its active version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      }
    },
    "/automations/{id}/enable": {
      "post": {
        "operationId": "enableAutomation",
        "tags": [
          "Automations"
        ],
        "summary": "Enable a published automation",
        "description": "Checks that the account is ready before turning the rule on. Safe to repeat.",
        "x-required-permission": "write",
        "responses": {
          "200": {
            "description": "The rule's status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationStatusResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyRequest"
              },
              "example": {}
            }
          }
        }
      }
    },
    "/automations/{id}/disable": {
      "post": {
        "operationId": "disableAutomation",
        "tags": [
          "Automations"
        ],
        "summary": "Disable a published automation",
        "description": "Stops new runs. Anyone already in a conversation can finish on the version they started with. Safe to repeat.",
        "x-required-permission": "write",
        "responses": {
          "200": {
            "description": "The rule's status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AutomationStatusResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmptyRequest"
              },
              "example": {}
            }
          }
        }
      }
    },
    "/runs": {
      "get": {
        "operationId": "listRuns",
        "tags": [
          "Runs"
        ],
        "summary": "List automation runs",
        "description": "Use needsReview to find runs where a send still needs a decision.",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "One page of runs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/RunStatus"
            }
          },
          {
            "name": "needsReview",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "description": "Use true for runs with unresolved sends, false for the rest. Leave it out for both."
          }
        ]
      }
    },
    "/runs/{id}": {
      "get": {
        "operationId": "getRun",
        "tags": [
          "Runs"
        ],
        "summary": "Get an automation run",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "The run and its current status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      }
    },
    "/runs/{id}/timeline": {
      "get": {
        "operationId": "getRunTimeline",
        "tags": [
          "Runs"
        ],
        "summary": "See what happened in a run",
        "description": "Events appear in time order. Acceptance means Instagram took the request. Delivery is a separate question. An uncertain send stays on hold until it can be resolved.",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "The run's recorded events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimelineResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ]
      }
    },
    "/leads": {
      "get": {
        "operationId": "listLeads",
        "tags": [
          "Leads"
        ],
        "summary": "List captured leads",
        "description": "Returns captured addresses and their CRM status. We check email format. Ownership is unverified.",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "One page of leads.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "IntegrationKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Integration API key",
        "description": "Paste the key itself. Swagger adds the Bearer header. Read keys can see captured email addresses. Write keys can also change rules."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The resource UUID in this workspace.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "How many items to return at most.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "description": "Pass nextCursor from the last page. Items sort by createdAt descending, then id descending for ties. A null nextCursor means you reached the end. An unknown cursor or one from another workspace returns 400.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "400": {
        "description": "Check the request fields, query parameters and cursor. For a publish request, check the rule content too.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Supply a valid integration key. A revoked key also gets this response.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "description": "Bearer authentication challenge.",
            "schema": {
              "type": "string",
              "const": "Bearer"
            }
          }
        }
      },
      "403": {
        "description": "Use a write key to change a rule. If you send X-Tenant-Id, it must match the workspace on the key. A mismatch returns TENANT_MISMATCH.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "scope": {
                "value": {
                  "error": "This operation requires a write API key.",
                  "code": "INSUFFICIENT_SCOPE"
                }
              },
              "tenant": {
                "value": {
                  "error": "The tenant header conflicts with the API key.",
                  "code": "TENANT_MISMATCH"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "This workspace has no resource with that ID.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Read the error code and fetch the latest record before retrying.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "revision_conflict": {
                "value": {
                  "error": "This automation changed. Reload before publishing.",
                  "code": "revision_conflict"
                }
              },
              "account_required": {
                "value": {
                  "error": "Choose a connected Instagram account before publishing.",
                  "code": "account_required"
                }
              },
              "reconnect_required": {
                "value": {
                  "error": "Connect or reconnect this Instagram account before publishing.",
                  "code": "reconnect_required"
                }
              },
              "paused": {
                "value": {
                  "error": "Resume this account before publishing.",
                  "code": "paused"
                }
              },
              "permissions_required": {
                "value": {
                  "error": "The account integration must confirm messaging permissions and limits.",
                  "code": "permissions_required"
                }
              },
              "delivery_unconfigured": {
                "value": {
                  "error": "Configure message delivery before publishing.",
                  "code": "delivery_unconfigured"
                }
              },
              "integration_mismatch": {
                "value": {
                  "error": "Reconnect this account through the configured Instagram integration.",
                  "code": "integration_mismatch"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "The server hit an unexpected error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
