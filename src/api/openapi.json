            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      },
      "post": {
        "operationId": "createDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Create an automation draft",
        "description": "Saves a new draft at revision 1. Omitted content defaults to an empty object. Repeating this request can create another draft. If the response is lost, check the draft list before trying again.",
        "x-required-permission": "write",
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraft"
              },
              "example": {
                "name": "Comment to email follow-up",
                "content": {
                  "keyword": "guide",
                  "publicReply": "I will send the details in a message.",
                  "emailPrompt": "What email should receive the guide?",
                  "linkText": "Here is the guide.",
                  "linkUrl": "https://example.com/guide",
                  "timeoutHours": 72,
                  "maxClarifications": 1,
                  "clarificationText": "Please reply with an email address."
                }
              }
            }
          }
        }
      }
    },
    "/drafts/{id}": {
      "get": {
        "operationId": "getDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Get an automation draft",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "Success.",
