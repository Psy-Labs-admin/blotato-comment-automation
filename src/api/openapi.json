            "$ref": "#/components/parameters/Id"
          }
        ]
      },
      "patch": {
        "operationId": "updateDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Update an automation draft",
        "description": "Use the current expectedRevision. Each save bumps it. Leave fields out to keep them, or set connectionId to null to remove the account. If you send content, include the whole content object. After a lost response or a revision_conflict, fetch the draft before trying again.",
        "x-required-permission": "write",
        "responses": {
          "200": {
            "description": "The updated draft and its new revision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraft"
              },
              "example": {
                "expectedRevision": 1,
                "content": {
                  "keyword": "guide",
                  "publicReply": "I will send the details in a message.",
                  "emailPrompt": "What email should receive the guide?",
                  "linkText": "Here is the guide.",
                  "linkUrl": "https://example.com/guide",
                  "timeoutHours": 72,
                  "maxClarifications": 1,
                  "clarificationText": "Please reply with an email address."
                }
              }
            }
          }
        }
      }
    },
    "/drafts/{id}/publish": {
      "post": {
        "operationId": "publishDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Publish a draft revision",
        "description": "Publish checks the rule and account, saves a fixed version and enables new runs. If the response gets lost, fetch the draft first. Repeating a publish for the same unchanged revision returns its version and preserves any later decision to disable the rule. Editing the draft makes the old revision stale.",
        "x-required-permission": "write",
        "responses": {
          "200": {
            "description": "The draft, automation ID and published version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpectedRevision"
              },
              "example": {
                "expectedRevision": 2
              }
            }
          }
        }
      }
    },
