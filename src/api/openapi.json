{
  "openapi": "3.1.0",
  "info": {
    "title": "Blotato Automation API",
    "version": "1.0.0",
    "description": "Call this API from your backend. A read key lets you follow runs and collect leads from one workspace. A write key also lets you edit and publish its rules."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin versioned public API"
    }
  ],
  "security": [
    {
      "IntegrationKey": []
    }
  ],
  "tags": [
    {
      "name": "Workspace",
      "description": "Find the workspace your key belongs to."
    },
    {
      "name": "Accounts",
      "description": "Pick an Instagram account that’s ready to run your rule."
    },
    {
      "name": "Drafts",
      "description": "Save work in progress and publish it when it’s ready."
    },
    {
      "name": "Automations",
      "description": "Choose which published rules can start conversations."
    },
    {
      "name": "Runs",
      "description": "Follow a conversation from its first comment to the last recorded step."
    },
    {
      "name": "Leads",
      "description": "Read captured addresses and see which ones reached the CRM."
    }
  ],
  "paths": {
    "/workspace": {
      "get": {
        "operationId": "getWorkspace",
        "tags": [
          "Workspace"
        ],
        "summary": "Get your workspace",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "Your workspace ID and name.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "operationId": "listAccounts",
        "tags": [
          "Accounts"
        ],
        "summary": "List Instagram accounts",
        "description": "Disconnected accounts stay in this list. Use canPublish and issue to choose an account for a rule.",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "Accounts in this workspace.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        }
      }
    },
    "/drafts": {
      "get": {
        "operationId": "listDrafts",
        "tags": [
          "Drafts"
        ],
        "summary": "List automation drafts",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "One page of drafts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftsResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/Cursor"
          }
        ]
      },
      "post": {
        "operationId": "createDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Create an automation draft",
        "description": "Give each new draft an Idempotency-Key. Lost the response? Send the same key and body again to get the original revision-1 response, even after an edit or credential rotation. Each call needs a valid write key for this workspace. Successful keys stay reserved indefinitely. Changing the input returns 409 idempotency_conflict. A failed create leaves the key available. Omitting the header creates a new draft on every call.",
        "x-required-permission": "write",
        "responses": {
          "201": {
            "description": "The saved draft at revision 1. A replay returns the same response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "description": "The key already belongs to different normalized input. Reuse the original input to retry, or choose a new key for a new draft.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "This idempotency key was used with different draft input.",
                  "code": "idempotency_conflict"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraft"
              },
              "example": {
                "name": "Comment to email follow-up",
                "content": {
                  "keyword": "guide",
                  "publicReply": "I will send the details in a message.",
                  "emailPrompt": "What email should receive the guide?",
                  "linkText": "Here is the guide.",
                  "linkUrl": "https://example.com/guide",
                  "timeoutHours": 72,
                  "maxClarifications": 1,
                  "clarificationText": "Please reply with an email address."
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "One case-sensitive token per logical draft creation, shared by all API credentials in the workspace. Send exactly one header. Same key with changed normalized input returns 409.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]{1,128}$"
            },
            "example": "pricing-rule-2026-11-10"
          }
        ]
      }
    },
    "/drafts/{id}": {
      "get": {
        "operationId": "getDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Get an automation draft",
        "x-required-permission": "read",
        "responses": {
          "200": {
            "description": "The saved draft and its current revision.",
