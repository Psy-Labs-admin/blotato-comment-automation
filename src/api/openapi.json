          },
          "linkUrl": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
          },
          "timeoutHours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 720
          },
          "clarificationText": {
            "type": "string",
            "maxLength": 1000,
            "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
          },
          "maxClarifications": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "postIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[^\\u0000\\uD800-\\uDFFF]*$"
            },
            "maxItems": 1000
          }
        },
        "required": [],
        "additionalProperties": false,
        "description": "Save as much of a draft as you have. To publish, supply a matchable keyword, public reply, email prompt and HTTP(S) link without credentials. Include clarification text if maxClarifications is above zero. Empty or omitted postIds covers all supported posts. Defaults are 72 hours and one clarification."
      },
