          }
        ]
      },
      "patch": {
        "operationId": "updateDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Update an automation draft",
        "description": "Supply the current expectedRevision. Each successful update advances the revision. Omitted fields keep their values. Supplying content replaces that entire object. Set connectionId to null to clear the account. After a lost response or a 409 revision_conflict, fetch the draft before retrying.",
        "x-required-permission": "write",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraft"
              },
              "example": {
                "expectedRevision": 1,
                "content": {
                  "keyword": "guide",
                  "publicReply": "I will send the details in a message.",
                  "emailPrompt": "What email should receive the guide?",
                  "linkText": "Here is the guide.",
                  "linkUrl": "https://example.com/guide",
                  "timeoutHours": 72,
                  "maxClarifications": 1,
                  "clarificationText": "Please reply with an email address."
                }
              }
            }
          }
        }
      }
    },
    "/drafts/{id}/publish": {
      "post": {
        "operationId": "publishDraft",
        "tags": [
          "Drafts"
        ],
        "summary": "Publish a draft revision",
        "description": "Validates complete content and account readiness, creates an immutable version, and activates the automation. Repeating the same expectedRevision after successful publication returns the existing version without creating another version or re-enabling a subsequently disabled automation. Editing the draft makes an older expectedRevision conflict. After an uncertain response, GET the draft and retry only the intended revision.",
        "x-required-permission": "write",
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpectedRevision"
              },
              "example": {
                "expectedRevision": 2
              }
            }
          }
        }
      }
    },
