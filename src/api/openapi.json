  "components": {
    "securitySchemes": {
      "IntegrationKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Integration API key",
        "description": "Enter the key value only. The client sends it in the `Authorization: Bearer` header. Read keys can retrieve leads, including their email addresses. Write keys also authorize rule changes."
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Workspace-scoped resource UUID.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "description": "Maximum page size.",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "description": "Use nextCursor from the previous page. UUID of the last returned resource, resolved within this workspace. Unknown or foreign-workspace cursors return 400. Pages use createdAt descending, then id descending. Null nextCursor means no further page.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "400": {
        "description": "Invalid input, unsupported query parameter, invalid cursor, or incomplete automation definition.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Missing, invalid, or revoked integration bearer key.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "headers": {
          "WWW-Authenticate": {
            "description": "Bearer authentication challenge.",
            "schema": {
              "type": "string",
              "const": "Bearer"
            }
          }
        }
      },
      "403": {
        "description": "A write key is required for mutations. If an X-Tenant-Id header is supplied, it must match the workspace bound to the key; a contradictory value returns TENANT_MISMATCH.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "scope": {
                "value": {
                  "error": "This operation requires a write API key.",
                  "code": "INSUFFICIENT_SCOPE"
                }
              },
              "tenant": {
                "value": {
                  "error": "The tenant header conflicts with the API key.",
                  "code": "TENANT_MISMATCH"
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "Resource not found in the authenticated workspace.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "State conflict. Inspect code, refresh the resource, and resolve the stated reason before retrying.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "revision_conflict": {
                "value": {
                  "error": "This automation changed. Reload before publishing.",
                  "code": "revision_conflict"
                }
              },
              "account_required": {
                "value": {
                  "error": "Choose a connected Instagram account before publishing.",
                  "code": "account_required"
                }
              },
              "reconnect_required": {
                "value": {
                  "error": "Connect or reconnect this Instagram account before publishing.",
                  "code": "reconnect_required"
                }
              },
              "paused": {
                "value": {
                  "error": "Resume this account before publishing.",
                  "code": "paused"
                }
              },
              "permissions_required": {
                "value": {
                  "error": "The account integration must confirm messaging permissions and limits.",
                  "code": "permissions_required"
                }
              },
              "delivery_unconfigured": {
                "value": {
                  "error": "Configure message delivery before publishing.",
                  "code": "delivery_unconfigured"
                }
              },
              "integration_mismatch": {
                "value": {
                  "error": "Reconnect this account through the configured Instagram integration.",
                  "code": "integration_mismatch"
                }
              }
            }
          }
        }
      },
      "500": {
        "description": "An unexpected server error occurred.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
