{
  "name": "blotato-comment-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Durable comment-triggered conversation automations (Blotato take-home)",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "quickstart": "node scripts/quickstart.cjs",
    "monitoring:init": "node scripts/monitoring-init.cjs",
    "verify": "node scripts/verify.cjs",
    "test:browser": "playwright test",
    "coverage:report": "node scripts/coverage-report.cjs",
    "telegram:check": "node --env-file-if-exists=.env dist/alerts/check.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "node scripts/build.cjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "migrate": "tsx src/storage/migrate.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:load": "tsx tests/load/load-check.ts",
    "typecheck": "tsc --noEmit",
    "api:key": "node scripts/api-key.cjs",
    "docs:build": "node scripts/build-reference.cjs"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.0",
    "@opentelemetry/resources": "3.1.0",
    "@opentelemetry/sdk-trace": "3.1.0",
    "@temporalio/activity": "^1.25.0",
    "@temporalio/client": "^1.25.0",
    "@temporalio/common": "^1.25.0",
    "@temporalio/worker": "^1.25.0",
    "@temporalio/workflow": "^1.25.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "swagger-ui-dist": "5.34.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@temporalio/nyc-test-coverage": "1.25.0",
    "@temporalio/testing": "^1.25.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-lib-source-maps": "5.0.6",
    "istanbul-reports": "3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "v8-to-istanbul": "9.3.0",
    "vitest": "4.1.12"
  },
  "scarfSettings": {
    "enabled": false
  }
}
